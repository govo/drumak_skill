# Drum AI PRESET MCP -- client-side environment variable template
#
# Usage: copy to .env and edit as needed. .env is excluded by .gitignore and stays on your machine.
#     cp .env.example .env
#
# This configures "where the client finds the service", not the service's own configuration.

# MCP service address. Defaults to the public deployment at https://c1c1.online/drumai_mcp;
# you normally do not need to change it.
# Either a bare address or a full endpoint works:
#     DRUMAI_MCP_URL=https://c1c1.online/drumai_mcp
#     DRUMAI_MCP_URL=https://c1c1.online/drumai_mcp/mcp
# Point this at your own service or another host, e.g. https://drum.example.com
DRUMAI_MCP_URL=https://c1c1.online/drumai_mcp

# Note: the following are SERVER-side environment variables. They belong on the machine running the
# service; setting them in this file has no effect.
#   HOST=0.0.0.0               listen on every interface; otherwise only that machine can connect
#                              (the default binds to the loopback address only)
#   PORT=8787                  service port
#   PUBLIC_BASE_URL=https://…  the domain used in the links render_preset produces.
#                              When unset, links point at the machine running the service, so only
#                              that machine can open them.
